# WeCom / 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=

# Callback verification
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# Optional: base path for webhook (default: /wecom/callback)
WECOM_WEBHOOK_PATH=/wecom/callback

# WeChat Customer Service (微信客服)
# gateway 负责回调验证和消息拉取，插件只需配置 Secret 和客服账号 ID
WECOM_KF_SECRET=
WECOM_KF_OPEN_KFID=
WECOM_KF_WEBHOOK_PATH=/wecom/kf/callback
