{
  "name": "@clouditera/openclaw-wechat",
  "version": "0.4.0",
  "type": "module",
  "description": "WeCom (企业微信) channel plugin for Clawdbot (internal apps + customer service).",
  "license": "MIT",
  "exports": "./src/index.js",
  "files": [
    "src/",
    "clawdbot.plugin.json",
    "docs/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clouditera/OpenClaw-Wechat.git"
  },
  "homepage": "https://github.com/Clouditera/OpenClaw-Wechat#readme",
  "bugs": {
    "url": "https://github.com/Clouditera/OpenClaw-Wechat/issues"
  },
  "keywords": [
    "clawdbot",
    "wecom",
    "wechat",
    "enterprise-wechat",
    "customer-service",
    "chatbot"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "clawdbot": {
    "extensions": [
      "./src/index.js"
    ],
    "channel": {
      "id": "wecom",
      "label": "WeCom",
      "selectionLabel": "WeCom (企业微信自建应用 + 微信客服)",
      "docsPath": "/channels/wecom",
      "docsLabel": "wecom",
      "blurb": "Enterprise WeChat internal app + customer service via callback + send API.",
      "order": 80,
      "aliases": [
        "wework",
        "qiwei",
        "wxwork"
      ]
    }
  },
  "dependencies": {
    "clawdbot": "*",
    "fast-xml-parser": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
