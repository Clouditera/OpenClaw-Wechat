{
  "id": "clawdbot-wecom",
  "name": "@clouditera/openclaw-wechat",
  "version": "0.4.0",
  "description": "WeCom (企业微信) channel plugin for Clawdbot (internal apps + customer service).",
  "extensions": ["./src/index.js"],
  "configSchema": {
    "type": "object",
    "properties": {
      "corpId": {
        "type": "string",
        "description": "企业微信 Corp ID"
      },
      "corpSecret": {
        "type": "string",
        "description": "企业微信 Corp Secret"
      },
      "agentId": {
        "type": "number",
        "description": "企业微信 Agent ID"
      },
      "callbackToken": {
        "type": "string",
        "description": "回调 Token"
      },
      "callbackAesKey": {
        "type": "string",
        "description": "回调 AES Key"
      },
      "webhookPath": {
        "type": "string",
        "description": "Webhook 路径",
        "default": "/wecom/callback"
      },
      "kf": {
        "type": "object",
        "description": "微信客服 (Customer Service) API 配置",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "是否启用客服 API",
            "default": false
          },
          "kfSecret": {
            "type": "string",
            "description": "客服应用 Secret（独立于自建应用 Secret）"
          },
          "openKfId": {
            "type": "string",
            "description": "客服账号 ID (kfxxxxxx)"
          },
          "webhookPath": {
            "type": "string",
            "description": "客服回调路径",
            "default": "/wecom/kf/callback"
          }
        }
      }
    }
  },
  "channel": {
    "id": "wecom",
    "label": "WeCom",
    "selectionLabel": "WeCom (企业微信自建应用 + 微信客服)",
    "docsPath": "/channels/wecom",
    "docsLabel": "wecom",
    "blurb": "Enterprise WeChat internal app + customer service via callback + send API.",
    "order": 80,
    "aliases": ["wework", "qiwei", "wxwork"]
  }
}
